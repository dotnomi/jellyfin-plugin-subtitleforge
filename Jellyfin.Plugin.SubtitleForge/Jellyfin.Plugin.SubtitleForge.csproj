<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.SubtitleForge</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" >
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- CPU-only ONNX Runtime; the managed package ships natives for linux-x64/arm64, win, osx. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <!-- Speech-to-text (whisper.cpp), CPU runtime only. -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenMP runtime needed by whisper.cpp; not present in the official Jellyfin image (GCC Runtime Library Exception). -->
    <None Include="Whisper/native/linux-x64/libgomp.so.1" Link="runtimes/linux-x64/libgomp.so.1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- whisper.cpp with Vulkan (GPU: AMD/Intel/NVIDIA), built by tools/build-whisper-vulkan.sh; loaded before the CPU runtime. -->
    <None Include="Whisper/native/vulkan/linux-x64/*.so" Link="runtimes/vulkan/linux-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Whisper/native/linux-arm64/libgomp.so.1" Link="runtimes/linux-arm64/libgomp.so.1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.SubtitleForge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Styling\client.js" />
    <EmbeddedResource Include="Styling\client.js" />
    <None Remove="Ocr\Models\*" />
    <EmbeddedResource Include="Ocr\Models\rec.onnx" />
    <EmbeddedResource Include="Ocr\Models\dict.txt" />
    <None Remove="Ocr\Dictionaries\*" />
    <EmbeddedResource Include="Ocr\Dictionaries\*.txt.gz" />
    <None Remove="Sync\Models\*" />
    <EmbeddedResource Include="Sync\Models\silero_vad.onnx" />
  </ItemGroup>

  <!-- Jellyfin loads every *.dll inside the plugin folder, so only ship the Linux natives (.so). -->
  <Target Name="StripNonLinuxRuntimes" AfterTargets="Publish">
    <ItemGroup>
      <_NonLinuxRuntime Include="$(PublishDir)runtimes/**/*" Exclude="$(PublishDir)runtimes/linux-x64/**/*;$(PublishDir)runtimes/linux-arm64/**/*;$(PublishDir)runtimes/vulkan/linux-x64/**/*" />
    </ItemGroup>
    <Delete Files="@(_NonLinuxRuntime)" />
    <!-- Framework assemblies pulled in by Whisper.net: Jellyfin's runtime already provides them; a second copy can clash. -->
    <Delete Files="$(PublishDir)System.Text.Json.dll;$(PublishDir)System.IO.Pipelines.dll;$(PublishDir)System.Text.Encodings.Web.dll" />
    <RemoveDir Directories="$(PublishDir)runtimes/win-x64;$(PublishDir)runtimes/win-arm64;$(PublishDir)runtimes/win-x86;$(PublishDir)runtimes/osx-arm64;$(PublishDir)runtimes/osx-x64;$(PublishDir)runtimes/macos-arm64;$(PublishDir)runtimes/macos-x64;$(PublishDir)runtimes/linux-arm;$(PublishDir)runtimes/android;$(PublishDir)runtimes/ios" />
  </Target>

  <!-- Whisper runs in a separate helper process (crash isolation); publish it next to the plugin. -->
  <Target Name="PublishWhisperHost" AfterTargets="Publish" Condition="'$(SkipWhisperHost)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Jellyfin.Plugin.SubtitleForge.WhisperHost/Jellyfin.Plugin.SubtitleForge.WhisperHost.csproj&quot; -c $(Configuration) -r linux-x64 -o &quot;$(PublishDir)whisperhost/linux-x64&quot; -nologo -v q" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Jellyfin.Plugin.SubtitleForge.WhisperHost/Jellyfin.Plugin.SubtitleForge.WhisperHost.csproj&quot; -c $(Configuration) -r linux-arm64 -o &quot;$(PublishDir)whisperhost/linux-arm64&quot; -nologo -v q" />
  </Target>

</Project>
